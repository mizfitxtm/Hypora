/* Generated by hypora-theme ({{ name }}). Linked into an Obsidian vault as .obsidian/snippets/hypora.css. */
/* !important so these win over whichever Minimal colour scheme is selected. */
body {
  --bg1: {{ background }} !important;
  --bg2: {{ surface }} !important;
  --bg3: {{ selection }} !important;
  --ui1: {{ surface }} !important;
  --ui2: {{ muted }} !important;
  --ui3: {{ dim }} !important;
  --tx1: {{ foreground }} !important;
  --tx2: {{ dim }} !important;
  --tx3: {{ muted }} !important;
  --hl1: {{ selection }} !important;
  --ax1: {{ accent }} !important;
  --ax2: {{ accent }} !important;
  --ax3: {{ accent }} !important;
  --text-accent: {{ accent }} !important;
  --interactive-accent: {{ accent }} !important;
  --color-red: {{ red }} !important;
  --color-orange: {{ bright_red }} !important;
  --color-yellow: {{ yellow }} !important;
  --color-green: {{ green }} !important;
  --color-cyan: {{ cyan }} !important;
  --color-blue: {{ blue }} !important;
  --color-purple: {{ magenta }} !important;
  --color-pink: {{ bright_magenta }} !important;
}
