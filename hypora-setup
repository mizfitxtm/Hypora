# Daily "updates are waiting" notification: a read-only user timer. A timer you turned off stays off on re-runs.
# Turn off: systemctl --user disable --now hypora-update-check.timer
log "Setting up the update notification timer"
first_timer=0
[ -f "$CONF/systemd/user/hypora-update-check.timer" ] || first_timer=1
put "$REPO/config/systemd/user/hypora-update-check.service" "$CONF/systemd/user/hypora-update-check.service"
put "$REPO/config/systemd/user/hypora-update-check.timer" "$CONF/systemd/user/hypora-update-check.timer"
# USB notifier: its path unit starts it only while Hardened mode is on. One you turned off stays off on re-runs.
