[ -f "$CONF/systemd/user/hypora-usb-watch.path" ] || first_usb=1
put "$REPO/config/systemd/user/hypora-usb-watch.service" "$CONF/systemd/user/hypora-usb-watch.service"
put "$REPO/config/systemd/user/hypora-usb-watch.path" "$CONF/systemd/user/hypora-usb-watch.path"
if systemctl --user daemon-reload 2>/dev/null; then
  if [ "$first_timer" -eq 1 ]; then
    systemctl --user enable --now hypora-update-check.timer >/dev/null 2>&1 ||
      warn "Could not start the update notification timer; run: systemctl --user enable --now hypora-update-check.timer"
  fi
  if [ "$first_usb" -eq 1 ]; then
    systemctl --user enable --now hypora-usb-watch.path >/dev/null 2>&1 ||
      warn "Could not start the USB notifier; run: systemctl --user enable --now hypora-usb-watch.path"
  fi
else
