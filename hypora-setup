shopt -s nullglob
bin_files=("$REPO"/bin/*)
if [ ${#bin_files[@]} -gt 0 ]; then
  log "Installing bin scripts to ~/.local/bin"
  for f in "${bin_files[@]}"; do
    # Files only: bin/* can also match a directory such as __pycache__
    [ -f "$f" ] || continue
    name=$(basename "$f")
    skip=
    for r in "${ROOT_OWNED[@]}"; do [ "$name" = "$r" ] && skip=1; done
