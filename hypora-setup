if [ -f "$REPO/config/hypr/hyprland.lua" ]; then
  put "$REPO/config/hypr/hyprland.lua" "$CONF/hypr/hyprland.lua"
  grep -Eq 'exec_cmd\(.*\b(qs|quickshell)\b' "$REPO/config/hypr/hyprland.lua" ||
