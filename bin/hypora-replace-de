#!/usr/bin/env python3
"""hypora-replace-de: remove another desktop and keep what Hypora needs.

    hypora-replace-de list            show what is installed and what removing it would take
    hypora-replace-de remove          remove it (needs root, asks first)
    hypora-replace-de remove --yes
    hypora-replace-de remove --session-only   only the shell and session, no sweep
    hypora-replace-de remove --no-autoremove  skip the orphan sweep
    hypora-replace-de remove --no-config      skip the settings cleanup in your home folder
    hypora-replace-de check           report leftovers and PAM damage, change nothing
    hypora-replace-de config          move GNOME Shell's settings out of your home folder (run as you)
    hypora-replace-de running         exit 0 if a desktop that could be removed is running now

Removal runs in four phases:

  1. Session: the shell, session manager and greeter.
  2. Leftovers: other packages named after that desktop that nothing Hypora keeps
     still needs. Nothing depends on them, so removing the shell alone leaves them.
  3. Orphans: `dnf autoremove` for libraries that only served what just left.
  4. Settings (GNOME only): the files and dconf keys that only GNOME Shell read, moved to a
     backup folder in your home, never deleted. Runs as you, after the shell is gone.

Phase 2 is safe because of the dependency closure, not the name. This script walks
everything the keep list needs (with rpm) and never removes any of it. A name like
gnome-* does not mean Hypora can live without it.

Phase 3 is safe because the keep list is first marked user-installed with
`dnf mark user`. Without that, autoremove took gnome-keyring-pam and gcr, which
silently broke keyring unlock.

The plan is always printed before anything is removed.
"""
import datetime
import os
import pwd
import re
from pathlib import Path
import shutil
import signal
import subprocess
import sys

# marker -> (display name, session packages, sweep prefixes, evidence prefixes); evidence guards broad prefixes like kf6-*.
DESKTOPS = {
    "gnome-shell": ("GNOME", [
        "gnome-shell", "gnome-session", "gnome-initial-setup",
        "gnome-browser-connector", "gnome-shell-extension-common", "gdm",
    ], ("gnome-", "libgnome", "gjs", "mutter", "gdm", "gnome-classic",
        "yelp"),  # yelp is named after its binary, so gnome-* misses it
       ("gnome-shell", "gnome-session", "gdm", "mutter", "gnome-settings-daemon",
        "gnome-initial-setup", "gnome-backgrounds", "gnome-classic",
        "gnome-control-center", "gnome-tour")),
    "plasma-workspace": ("KDE Plasma", [
        "plasma-workspace", "plasma-desktop", "plasma-workspace-wayland",
        "kwin", "sddm-kcm", "plasma-nm", "kde-settings-plasma",
    ], ("plasma-", "kde-", "kf5-", "kf6-", "kwin", "libkf5", "libkf6", "kactivit",
        "polkit-kde", "dolphin", "konsole", "kscreen", "ksshaskpass", "kwallet"),
       ("plasma-workspace", "plasma-desktop", "kwin", "kde-settings", "sddm-kcm",
        "dolphin", "konsole", "kscreen", "plasma-nm")),
    "xfdesktop": ("Xfce", [
        "xfdesktop", "xfwm4", "xfce4-session", "xfce4-panel", "lightdm",
    ], ("xfce", "xfwm", "xfdesktop", "xfconf", "libxfce", "thunar", "garcon",
        "tumbler", "lightdm"),
       ("xfce4-session", "xfwm4", "xfdesktop", "xfce4-panel", "thunar")),
    "cinnamon": ("Cinnamon", [
        "cinnamon", "cinnamon-session", "cinnamon-screensaver", "muffin",
    ], ("cinnamon", "muffin", "nemo", "xapp", "xed", "xviewer", "xreader"),
       ("cinnamon", "muffin", "nemo")),
    "mate-session-manager": ("MATE", [
        "mate-session-manager", "mate-panel", "marco", "mate-desktop",
    ], ("mate-", "marco", "caja", "atril", "pluma", "eom"),
       ("mate-session-manager", "mate-panel", "marco", "caja")),
    "lxqt-session": ("LXQt", [
        "lxqt-session", "lxqt-panel", "lxqt-runner", "openbox",
    ], ("lxqt", "openbox", "obconf", "pcmanfm"),
       ("lxqt-session", "lxqt-panel", "pcmanfm")),
    "budgie-desktop": ("Budgie", [
        "budgie-desktop", "budgie-desktop-view", "budgie-screensaver",
    ], ("budgie",), ("budgie-desktop",)),
    "cosmic-session": ("COSMIC", [
        "cosmic-session", "cosmic-comp", "cosmic-panel", "cosmic-greeter",
    ], ("cosmic",), ("cosmic-session", "cosmic-comp")),
    "sway": ("Sway", ["sway", "swayidle", "swaylock"],
             ("sway", "swayidle", "swaylock", "swaybg"), ("sway",)),
    "i3": ("i3", ["i3", "i3status", "i3lock"],
           ("i3-", "i3status", "i3lock"), ("i3", "i3status")),
}

# Never removed, with everything they need. "hypora" brings in every Requires of hypora.spec.
KEEP = [
    "hypora",
    "nautilus", "gvfs", "gnome-calculator", "gnome-disk-utility", "gnome-software",
    "adw-gtk3-theme", "gnome-keyring",
    # GNOME apps Hypora keeps because nothing else replaces them
    "gnome-calendar", "baobab", "simple-scan",
    "papers", "evince",               # same viewer before and after Fedora's rename
    "loupe", "gnome-text-editor", "mpv",
    "gsettings-desktop-schemas",      # theming and the Security window read these
    "glib2", "gtk3", "gtk4", "libadwaita",
    "xdg-desktop-portal", "xdg-desktop-portal-gtk",
    "polkit", "pipewire", "wireplumber", "NetworkManager",
    "sddm", "hyprland", "quickshell",
    # Names that do not look like they belong to Hypora, but removing them broke things:
    "xorg-x11-server-Xwayland",       # needed by every X11 app
    "gnome-keyring-pam", "gcr", "gcr3",   # pam_gnome_keyring.so lives in -pam
    "gnome-srpm-macros",              # removing it breaks rpm builds
    "iio-sensor-proxy",               # laptop light and orientation sensors
    "localsearch",                    # nautilus requires it
    "bluez-obexd",                    # Bluetooth file transfer
    # "sushi" (Nautilus preview) is not kept: it pulls in a 155 MiB web engine.
]

# dnf install reasons that autoremove is allowed to remove
DEP_REASONS = ("dependency", "weak-dependency", "weak dependency")


def run(cmd, timeout=120):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except (OSError, subprocess.SubprocessError) as e:
        return 1, str(e)


def rpm_q(args, timeout=60):
    """Run an rpm query and return its non-empty lines."""
    rc, out = run(["rpm"] + args, timeout=timeout)
    return [l.strip() for l in out.splitlines() if l.strip() and "no package" not in l]


def installed(pkg):
    return run(["rpm", "-q", pkg], timeout=20)[0] == 0


def installed_names():
    return set(rpm_q(["-qa", "--qf", "%{NAME}\n"]))


def requires_closure(roots, present):
    """Return every installed package that `roots` need, directly or not (roots included).

    Uses rpm because it is local and understands sonames. A query by package name
    would miss that nautilus needs libgnome-autoar-0.so.0, not a package called
    gnome-autoar.
    """
    seen = {r for r in roots if r in present}
    frontier = sorted(seen)
    while frontier:
        caps = []
        for line in rpm_q(["-q", "--requires"] + frontier):
            cap = line.split()[0]
            # rpm itself satisfies rpmlib() and config()
            if cap and not cap.startswith(("rpmlib(", "config(")):
                caps.append(cap)
        providers = set()
        for i in range(0, len(caps), 200):      # keep each command line short
            providers |= set(rpm_q(["-q", "--whatprovides", "--qf", "%{NAME}\n"]
                                   + caps[i:i + 200]))
        new = (providers & present) - seen
        seen |= new
        frontier = sorted(new)
    return seen


def leftovers(patterns, present, protected):
    """Installed packages matching `patterns` that nothing on the keep list needs."""
    return sorted(n for n in present
                  if n.startswith(tuple(patterns))
                  and n not in protected
                  and n not in KEEP)


def install_reason(pkg):
    rc, out = run(["dnf", "repoquery", "--installed", "--qf", "%{reason}", pkg], timeout=60)
    return out.strip().splitlines()[0].strip().lower() if rc == 0 and out.strip() else ""


def mark_user(pkgs):
    """Mark packages user-installed so `dnf autoremove` leaves them alone."""
    pkgs = [p for p in pkgs if installed(p)]
    if not pkgs:
        return
    at_risk = [p for p in pkgs if install_reason(p) in DEP_REASONS]
    # -y and a timeout, because dnf otherwise waits forever for another dnf's lock
    rc, out = run(["dnf", "-y", "mark", "user", "--skip-unavailable"] + pkgs, timeout=180)
    if rc != 0:
        print(f"Warning: could not mark packages user-installed, so `dnf autoremove` may "
              f"still take them. Skipping the orphan sweep would be safer.\n{out[-500:]}",
              file=sys.stderr)
        return False
    print(f"Marked {len(pkgs)} keep-list packages user-installed"
          + (f" ({len(at_risk)} were at risk: {' '.join(sorted(at_risk))})" if at_risk else ""))
    return True


PROTECTED_D = Path("/etc/dnf/protected.d")


def protection_file(marker):
    """Return the protected.d file that protects `marker`, or None.

    Fedora protects gnome-shell from removal. dnf has no flag to lift one protection,
    so we move that single file aside while removing, then put it back.
    """
    if not PROTECTED_D.is_dir():
        return None
    for f in sorted(PROTECTED_D.glob("*.conf")):
        try:
            if marker in f.read_text().split():
                return f
        except OSError:
            continue
    return None


DISABLED_SUFFIX = ".hypora-disabled"


def restore_stale_protection():
    """Put back a protection file that an earlier run moved aside and never restored.

    This happens if that run was killed (SIGKILL, power cut) mid-removal.
    """
    if not PROTECTED_D.is_dir():
        return
    for moved in PROTECTED_D.glob(f"*.conf{DISABLED_SUFFIX}"):
        original = moved.with_name(moved.name[:-len(DISABLED_SUFFIX)])
        if original.exists():
            moved.unlink()      # a package reinstalled it; that copy is newer
        else:
            shutil.move(str(moved), str(original))
            print(f"Restored {original}, left aside by an interrupted earlier run.")


class protection_lifted:
    """Context manager: move a protection file aside, and always put it back.

    SIGHUP and SIGTERM (for example, closing the terminal) are turned into a normal
    exit so the file is restored.
    """

    SIGNALS = (signal.SIGHUP, signal.SIGTERM)

    def __init__(self, path):
        self.path = path
        self.moved = None
        self.previous = {}

    @staticmethod
    def _exit(signum, frame):
        raise SystemExit(128 + signum)

    def __enter__(self):
        for s in self.SIGNALS:
            self.previous[s] = signal.signal(s, self._exit)
        if self.path and self.path.is_file():
            self.moved = self.path.with_name(self.path.name + DISABLED_SUFFIX)
            shutil.move(str(self.path), str(self.moved))
        return self

    def __exit__(self, *exc):
        try:
            if self.moved and self.moved.is_file():
                shutil.move(str(self.moved), str(self.path))
        finally:
            for s, handler in self.previous.items():
                signal.signal(s, handler)
        return False


def excludes():
    return [f"--exclude={p}" for p in KEEP]


def plan(pkgs):
    """Ask dnf what removing `pkgs` would do, without doing it.

    Returns (packages to remove, dnf output). The first is None if dnf refused.
    """
    rc, out = run(["dnf", "remove", "--assumeno"] + pkgs + excludes(), timeout=300)
    if "protected packages" in out or "Failed to resolve" in out:
        return None, out
    removing = []
    in_list = False
    for line in out.splitlines():
        if re.match(r"^\s*(Removing|Remove)\b", line):
            in_list = True
            continue
        if in_list:
            if not line.strip() or line.startswith(("Transaction", "Freed", "Operation")):
                in_list = False
                continue
            m = re.match(r"^\s*([a-zA-Z0-9._+-]+)\s", line)
            if m:
                removing.append(m.group(1))
    return removing, out


def freed(raw):
    m = re.search(r"After this operation, ([\d.]+\s*[KMG]i?B) will be freed", raw)
    return m.group(1) if m else None


def running_desktop():
    """Name of the running desktop session, lowercased, or ''."""
    return (os.environ.get("XDG_CURRENT_DESKTOP")
            or os.environ.get("DESKTOP_SESSION") or "").lower()


# Processes that mean a desktop is up. sudo clears XDG_CURRENT_DESKTOP, so the environment alone
# said "not running" when removal was started from a GNOME terminal, and the session crashed.
RUNNING = {
    "gnome-shell": ("gnome-shell",),
    "plasma-workspace": ("plasmashell", "kwin_wayland", "kwin_x11"),
    "xfdesktop": ("xfdesktop", "xfwm4"),
    "cinnamon": ("cinnamon",),
    "mate-session-manager": ("mate-session", "mate-panel"),
    "lxqt-session": ("lxqt-session",),
    "budgie-desktop": ("budgie-wm",),
    "cosmic-session": ("cosmic-session", "cosmic-comp"),
    "sway": ("sway",),
    "i3": ("i3",),
}


def is_running(name):
    """True if the desktop we were asked to remove is running now.

    Removing a running shell would kill the terminal in the middle of the dnf run.
    """
    cur = running_desktop()
    if cur and name.lower().split()[0] in cur:
        return True
    for marker, (display, *_rest) in DESKTOPS.items():
        if display == name:
            return any(run(["pgrep", "-x", proc], timeout=10)[0] == 0
                       for proc in RUNNING.get(marker, ()))
    return False


def detected(present=None, protected=None):
    """Return [(name, marker, installed session packages, sweep prefixes)].

    A desktop counts if its marker is installed, or if the marker is gone but its
    packages remain (for example, someone removed gnome-shell by hand).
    """
    present = present if present is not None else installed_names()
    if protected is None:
        protected = requires_closure(KEEP, present)
    out = []
    for marker, (name, pkgs, patterns, evidence) in sorted(DESKTOPS.items()):
        session = [p for p in pkgs if p in present]
        proven = (marker in present or bool(session)
                  or any(n.startswith(tuple(evidence)) for n in present))
        if proven and (session or leftovers(patterns, present, protected)):
            out.append((name, marker, session, patterns))
    return out


PAM_MODULE = "pam_gnome_keyring.so"


def pam_damage():
    """Return PAM files that name pam_gnome_keyring.so when the module is missing.

    The PAM lines are optional, so a missing module is skipped without any log message.
    Login works but the keyring never unlocks.
    """
    have = any(Path(p).exists() for p in
               ("/usr/lib64/security/" + PAM_MODULE, "/usr/lib/security/" + PAM_MODULE))
    if have:
        return []
    hits = []
    pamd = Path("/etc/pam.d")
    if pamd.is_dir():
        for f in sorted(pamd.iterdir()):
            try:
                if f.is_file() and PAM_MODULE in f.read_text():
                    hits.append(f.name)
            except OSError:
                continue
    return hits


def report_pam():
    hits = pam_damage()
    if not hits:
        return True
    sys.stdout.flush()
    print(f"\nWARNING: {PAM_MODULE} is referenced by /etc/pam.d/{{{','.join(hits)}}} but the "
          f"module is not installed, so keyring auto-unlock is silently doing nothing.",
          file=sys.stderr)
    print("Fix with: sudo dnf install gnome-keyring-pam gcr", file=sys.stderr)
    return False


# What only GNOME Shell and its session read in your home folder. The GTK, keyring, mimeapps and
# Nautilus settings Hypora uses are not listed, and online accounts (goa-1.0) are your own data.
GNOME_USER_PATHS = [
    ".local/share/gnome-shell", ".config/gnome-shell", ".config/gnome-session",
    ".config/gnome-initial-setup-done", ".config/monitors.xml", ".cache/gnome-shell",
]
# The same, in dconf. Hypora reads only desktop/interface (it writes the GTK theme there) and
# desktop/privacy (the Security window), so those and the rest of org/gnome/desktop stay.
GNOME_DCONF = ["/org/gnome/shell/", "/org/gnome/mutter/", "/org/gnome/desktop/wm/",
               "/org/gnome/settings-daemon/", "/org/gnome/gnome-session/",
               "/org/gnome/control-center/", "/org/gnome/login-screen/",
               "/org/gnome/desktop/notifications/", "/org/gnome/desktop/session/",
               "/org/gnome/desktop/search-providers/", "/org/gnome/desktop/app-folders/",
               "/org/gnome/desktop/screensaver/"]


def gnome_config(home):
    """Paths under `home` that only GNOME Shell used."""
    return [home / p for p in GNOME_USER_PATHS
            if (home / p).exists() or (home / p).is_symlink()]


def dconf_env():
    env = dict(os.environ)
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path=/run/user/{os.getuid()}/bus")
    return env


def dconf_run(args):
    """Run dconf as this user; returns (returncode, stdout). Missing dconf counts as failure."""
    if not shutil.which("dconf"):
        return 1, ""
    try:
        p = subprocess.run(["dconf"] + args, capture_output=True, text=True,
                           timeout=30, env=dconf_env())
    except (OSError, subprocess.SubprocessError):
        return 1, ""
    return p.returncode, p.stdout


def gnome_dconf():
    """GNOME dconf paths that hold anything."""
    return [d for d in GNOME_DCONF
            if (lambda r: r[0] == 0 and r[1].strip())(dconf_run(["list", d]))]


def user_home():
    """Home of the person at the keyboard: the sudo caller when run as root, else this user."""
    if os.geteuid() != 0:
        return Path.home()
    name = os.environ.get("SUDO_USER")
    if name and name != "root":
        try:
            return Path(pwd.getpwnam(name).pw_dir)
        except KeyError:
            pass
    return None


def cmd_config(assume_yes=False, home=None, use_dconf=True):
    """Move GNOME Shell's leftover settings out of the home folder, keeping a backup."""
    if home is None:
        if os.geteuid() == 0:
            sys.exit("Run this as your own user, not root:\n    hypora-replace-de config")
        home = Path.home()
    if "gnome-shell" in installed_names():
        print("GNOME Shell is still installed, so those settings are in use. Remove it first:\n"
              "    sudo hypora-replace-de remove", file=sys.stderr)
        return 1
    if is_running("GNOME"):
        print("You are running GNOME right now. Reboot into Hypora and run this again.",
              file=sys.stderr)
        return 1

    files = gnome_config(home)
    keys = gnome_dconf() if use_dconf else []
    if not files and not keys:
        print("No GNOME Shell settings are left in your home folder.")
        return 0

    dest = (home / ".local/share/hypora/removed-gnome-config"
            / datetime.datetime.now().strftime("%Y%m%d-%H%M%S"))
    print("\nGNOME Shell settings left behind:")
    for f in files:
        print(f"  {f}")
    for k in keys:
        print(f"  dconf {k}")
    print(f"\nThey are moved to {dest}, not deleted. Settings Hypora uses (GTK theme, keyring,\n"
          "default apps, online accounts, Nautilus) are not touched.")
    if not confirm("Move them?", assume_yes):
        print("Left them alone.")
        return 0

    for f in files:
        target = dest / f.relative_to(home)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(f), str(target))
    for k in keys:
        rc, dump = dconf_run(["dump", k])
        if rc != 0 or not dump.strip():
            print(f"Could not back up dconf {k}; left it alone.", file=sys.stderr)
            continue
        out = dest / "dconf" / (k.strip("/").replace("/", "_") + ".ini")
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(dump)
        if dconf_run(["reset", "-f", k])[0] != 0:
            print(f"Backed up dconf {k} but could not reset it.", file=sys.stderr)
    print(f"Done. To undo: move the files back from {dest}"
          + (f", and run `dconf load <path> < {dest}/dconf/<file>.ini` for each dconf backup."
             if keys else "."))
    return 0


def offer_config(assume_yes):
    """After the packages are gone: run `config` as the person who ran sudo."""
    home = user_home()
    if not home or os.geteuid() != 0 or "gnome-shell" in installed_names():
        return
    if not gnome_config(home):
        return
    name = os.environ["SUDO_USER"]
    print("\n=== GNOME settings in your home folder ===")
    env = dict(os.environ, HOME=str(home),
               DBUS_SESSION_BUS_ADDRESS=f"unix:path=/run/user/{pwd.getpwnam(name).pw_uid}/bus")
    subprocess.run(["runuser", "-u", name, "--", sys.executable, os.path.abspath(sys.argv[0]),
                    "config"] + (["--yes"] if assume_yes else []), env=env)


def cmd_check():
    present = installed_names()
    protected = requires_closure(KEEP, present)
    found = detected(present, protected)
    if not found:
        print("No other desktop environment or window manager is installed.")
    else:
        for name, marker, pkgs, patterns in found:
            extra = leftovers(patterns, present, protected)
            print(f"{name} (detected by {marker})")
            print(f"  session packages still installed: {len(pkgs)}")
            print(f"  leftover packages                : {len(extra)}")
            if extra:
                print(f"    {' '.join(extra)}")
    rc, out = run(["dnf", "autoremove", "--assumeno"] + excludes(), timeout=300)
    print(f"\nOrphaned packages `dnf autoremove` would take: "
          f"{'none' if 'Nothing to do' in out else 'some — run remove to see the plan'}")
    ok = report_pam()
    home = user_home()
    left = gnome_config(home) if home and "gnome-shell" not in installed_names() else []
    if left:
        print(f"\nGNOME Shell settings still in {home}: {len(left)} path(s). "
              "Clear them with: hypora-replace-de config")
    return 0 if ok else 1


def cmd_running():
    return 0 if any(is_running(name) for name, *_ in detected()) else 1


def cmd_list():
    present = installed_names()
    protected = requires_closure(KEEP, present)
    found = detected(present, protected)
    if not found:
        print("No other desktop environment or window manager is installed.")
        return 1
    for name, marker, pkgs, patterns in found:
        mark = "  (currently running)" if is_running(name) else ""
        extra = leftovers(patterns, present, protected)
        print(f"{name}{mark}")
        print(f"  detected by  : {marker}")
        print(f"  session      : {' '.join(pkgs) or '(none installed)'}")
        print(f"  leftovers    : {' '.join(extra) or '(none)'}")
        held = sorted(n for n in present
                      if n.startswith(tuple(patterns)) and (n in protected or n in KEEP))
        print(f"  kept ({len(held)}): {' '.join(held)}")
    cur = running_desktop()
    if cur:
        print(f"\nCurrent session: {cur}")
    return 0


def confirm(question, assume_yes):
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        print("Not a terminal and --yes not given; nothing removed.", file=sys.stderr)
        return False
    return input(f"{question} [y/N] ").strip().lower().startswith("y")


def do_remove(label, pkgs, marker, assume_yes):
    """Show the plan (with side effects), ask, then remove. Return True if it ran."""
    with protection_lifted(protection_file(marker)):
        removing, raw = plan(pkgs)
    if removing is None:
        print(f"dnf refused the {label} transaction; nothing removed. It said:\n"
              f"{raw[-1500:]}", file=sys.stderr)
        return False
    if not removing:
        print(f"Nothing to remove for {label}.")
        return False

    collateral = [p for p in removing if p not in pkgs]
    space = freed(raw)
    print(f"\n{label}: {len(removing)} packages"
          + (f", {space} freed" if space else ""))
    print(f"  requested ({len(pkgs)}): {' '.join(pkgs)}")
    if collateral:
        print(f"  pulled in by dependencies ({len(collateral)}):")
        for i in range(0, len(collateral), 4):
            print("    " + "  ".join(f"{p:<28}" for p in sorted(collateral)[i:i + 4]).rstrip())
        print("  Read that list. Anything there that you use is a reason to stop.")

    if not confirm(f"Remove these {len(removing)} packages?", assume_yes):
        print(f"Left {label} alone.")
        return False

    with protection_lifted(protection_file(marker)):
        rc, out = run(["dnf", "remove", "-y"] + pkgs + excludes(), timeout=3600)
    if rc != 0:
        print(f"Could not complete {label}:\n{out[-1500:]}", file=sys.stderr)
        return False
    print(f"{label}: done.")
    return True


def cmd_remove(assume_yes=False, session_only=False, do_autoremove=True, do_config=True):
    if os.geteuid() != 0:
        sys.exit("This removes packages, so it needs root:\n    sudo hypora-replace-de remove")

    present = installed_names()
    found = detected(present)
    if not found:
        print("No other desktop environment or window manager is installed.")
        if do_config:
            offer_config(assume_yes)
        return 0

    # Only check packages that were installed before; a never-installed one is not "missing"
    before = [p for p in KEEP if p in present]

    # Mark first, so a run that is interrupted later still leaves the keep list protected
    if do_autoremove:
        mark_user(KEEP)

    protected = requires_closure(KEEP, present)
    touched = False

    for name, marker, pkgs, patterns in found:
        print(f"\n=== {name} ===")
        if is_running(name):
            print(f"Skipping: you are running {name} right now. Removing the shell out from "
                  "under a live session takes the terminal with it, part-way through a dnf "
                  "transaction. Reboot into Hypora and run this again.", file=sys.stderr)
            continue

        if pkgs:
            touched |= do_remove(f"{name} session", pkgs, marker, assume_yes)
        else:
            print(f"{name}'s session is already gone; sweeping what it left behind.")

        if session_only:
            continue
        # Query again: the session removal changed what is installed
        now = installed_names()
        extra = leftovers(patterns, now, requires_closure(KEEP, now))
        if extra:
            touched |= do_remove(f"{name} leftovers", extra, marker, assume_yes)
        else:
            print(f"No {name} leftovers to sweep.")

    if do_autoremove:
        print("\n=== orphaned dependencies ===")
        rc, out = run(["dnf", "autoremove", "--assumeno"] + excludes(), timeout=600)
        if "Nothing to do" in out:
            print("Nothing orphaned.")
        else:
            space = freed(out)
            print(f"`dnf autoremove` would remove packages"
                  + (f", freeing {space}" if space else "") + ".")
            print("These are libraries nothing requires any more. The keep list is marked "
                  "user-installed and passed as excludes, so it is not eligible.")
            if confirm("Run dnf autoremove?", assume_yes):
                rc, out = run(["dnf", "autoremove", "-y"] + excludes(), timeout=3600)
                if rc != 0:
                    print(f"autoremove failed:\n{out[-1000:]}", file=sys.stderr)
                else:
                    print("Orphans removed.")
                    touched = True
            else:
                print("Left orphans in place.")

    # A keep-list package can leave quietly as a dependency, so check they are all still here
    missing = [p for p in before if not installed(p)]
    ok = True
    if missing:
        print(f"\nWARNING: these are gone and Hypora needs them: {' '.join(missing)}",
              file=sys.stderr)
        print(f"Put them back with: sudo dnf install {' '.join(missing)}", file=sys.stderr)
        ok = False
    elif touched:
        print("\nChecked: the schemas and apps Hypora depends on are still installed.")
    if not report_pam():
        ok = False
    if do_config:
        offer_config(assume_yes)
    return 0 if ok else 1


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "list"
    if cmd in ("-h", "--help"):
        print(__doc__, file=sys.stderr)
        return 0
    if cmd == "list":
        return cmd_list()
    if cmd == "check":
        return cmd_check()
    if cmd == "remove":
        if os.geteuid() == 0:
            restore_stale_protection()
        return cmd_remove(assume_yes="--yes" in argv or "-y" in argv,
                          session_only="--session-only" in argv,
                          do_autoremove="--no-autoremove" not in argv,
                          do_config="--no-config" not in argv)
    if cmd == "running":
        return cmd_running()
    if cmd == "config":
        return cmd_config(assume_yes="--yes" in argv or "-y" in argv)
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
